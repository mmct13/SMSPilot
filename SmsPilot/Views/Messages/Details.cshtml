@model SmsPilot.Models.SmsMessage
@{
    ViewData["Title"] = "Détails du Message";
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">Détails du Message</h3>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Date de création</dt>
            <dd class="col-sm-9">@Model.DateCreation.ToString("dd/MM/yyyy HH:mm:ss")</dd>

            <dt class="col-sm-3">Date d'envoi prévue</dt>
            <dd class="col-sm-9">
                @if (Model.DateEnvoiPrevue.HasValue)
                {
                    @Model.DateEnvoiPrevue.Value.ToString("dd/MM/yyyy HH:mm:ss")
                }
                else
                {
                    <span class="text-muted">Immédiat</span>
                }
            </dd>

            <dt class="col-sm-3">Destinataire</dt>
            <dd class="col-sm-9">@Model.Destinataire</dd>

            <dt class="col-sm-3">Statut</dt>
            <dd class="col-sm-9">
                @if (Model.Statut == SmsPilot.Models.SmsStatus.Envoye)
                {
                    <span class="badge bg-success">Envoyé</span>
                }
                else if (Model.Statut == SmsPilot.Models.SmsStatus.Echec)
                {
                    <span class="badge bg-danger">Échec</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">En attente</span>
                }
            </dd>

            <dt class="col-sm-3">API Message ID</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrEmpty(Model.ApiMessageId))
                {
                    <code>@Model.ApiMessageId</code>
                }
                else
                {
                    <span class="text-muted">-</span>
                }
            </dd>

            <dt class="col-sm-3">Contenu</dt>
            <dd class="col-sm-9">
                <div class="p-3 bg-light rounded border">
                    @Model.Contenu
                </div>
            </dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Index" class="btn btn-secondary">Retour à la liste</a>
    </div>
</div>
